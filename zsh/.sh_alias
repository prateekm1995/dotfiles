# Tmux aliases
alias ta='tmux attach -t main'
alias tk='tmux kill-session -t main'
alias tls='tmux ls'

# Git aliases
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline'

# Navigation aliases
alias ll='ls -lh'
alias la='ls -lha'
alias ..='cd ..'
alias ...='cd ../..'

# Utility aliases
alias mkdir='mkdir -p'
alias grep='grep --color=auto'

# Search through aliases
alias aliases='grep "^alias" ~/.sh_alias'
alias grep_alias='grep "^alias" ~/.sh_alias | grep'
